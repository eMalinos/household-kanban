{
  "config": {
    "step": {
      "user": {
        "title": "Household Kanban",
        "description": "Set up a shared household board. A Household to-do list is created automatically."
      }
    },
    "abort": {
      "single_instance_allowed": "[%key:common::config_flow::abort::single_instance_allowed%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Household Kanban",
        "menu_options": {
          "end_of_day": "End of day",
          "notifications": "Notifications",
          "parents": "Parents"
        }
      },
      "end_of_day": {
        "title": "End of day",
        "description": "What happens at the close time to open items that are due that day or earlier.",
        "data": {
          "end_of_day_mode": "Mode",
          "close_time": "Close time"
        },
        "data_description": {
          "end_of_day_mode": "Keep: nothing changes. Mark overdue: items are shown as overdue. Move: the due moves to the next day, same time. Raise: the priority goes up one step.",
          "close_time": "When the day closes (local time)."
        }
      },
      "notifications": {
        "title": "Notifications",
        "description": "A morning summary of what the end of day changed, with action buttons.",
        "data": {
          "notify_enabled": "Send notifications",
          "notify_time": "Notify time",
          "notify_assignee": "Notify assignees on their own phone",
          "notify_services": "Notify services"
        },
        "data_description": {
          "notify_assignee": "Items of a person without a phone go to the selected services.",
          "notify_services": "Phones that get unassigned items (and items of people without a phone)."
        }
      },
      "parents": {
        "title": "Parents",
        "menu_options": {
          "add_parent": "Add a parent",
          "edit_parent": "Edit a parent",
          "remove_parent": "Remove a parent"
        }
      },
      "add_parent": {
        "title": "Add a parent",
        "description": "A parent is a to-do list shown as a column group on the board.",
        "data": {
          "name": "Name",
          "icon": "Icon",
          "color": "Colour",
          "collapse": "Collapsed on the board"
        }
      },
      "edit_parent": {
        "title": "Edit a parent",
        "data": {
          "parent": "Parent"
        }
      },
      "edit_parent_details": {
        "title": "Edit a parent",
        "description": "The ID {parent} and the entity stay the same.",
        "data": {
          "name": "Name",
          "icon": "Icon",
          "color": "Colour",
          "collapse": "Collapsed on the board"
        }
      },
      "remove_parent": {
        "title": "Remove a parent",
        "description": "Its items and history move to the target parent. Household cannot be removed.",
        "data": {
          "parent": "Parent to remove",
          "target": "Move items to"
        }
      }
    },
    "error": {
      "name_required": "Enter a name.",
      "same_parent": "Choose a different parent to move the items to."
    },
    "abort": {
      "entry_not_loaded": "Household Kanban is not loaded."
    }
  },
  "selector": {
    "end_of_day_mode": {
      "options": {
        "keep": "Keep",
        "overdue": "Mark overdue",
        "move": "Move to the next day",
        "raise": "Raise priority"
      }
    },
    "parent_color": {
      "options": {
        "red": "Red",
        "orange": "Orange",
        "yellow": "Yellow",
        "green": "Green",
        "teal": "Teal",
        "cyan": "Cyan",
        "blue": "Blue",
        "indigo": "Indigo",
        "purple": "Purple",
        "pink": "Pink",
        "brown": "Brown",
        "grey": "Grey"
      }
    }
  },
  "services": {
    "create_item": {
      "name": "Create item",
      "description": "Adds an item with metadata to a parent.",
      "fields": {
        "parent": {
          "name": "Parent",
          "description": "Parent (to-do list) ID, e.g. household."
        },
        "summary": {
          "name": "Summary",
          "description": "What needs to be done."
        },
        "description": {
          "name": "Description",
          "description": "Optional details."
        },
        "due": {
          "name": "Due",
          "description": "Date (2026-11-02) or date and time (2026-11-02T18:00, local time if no offset). Empty clears it."
        },
        "priority": {
          "name": "Priority",
          "description": "1 = High, 2 = Medium, 3 = Low."
        },
        "assignee": {
          "name": "Assignee",
          "description": "Person responsible for the item."
        }
      }
    },
    "update_item": {
      "name": "Update item",
      "description": "Changes an item; a changed due resets moved and raised.",
      "fields": {
        "uid": {
          "name": "Item ID",
          "description": "The item's UID."
        },
        "summary": {
          "name": "Summary",
          "description": "What needs to be done."
        },
        "description": {
          "name": "Description",
          "description": "Optional details."
        },
        "due": {
          "name": "Due",
          "description": "Date (2026-11-02) or date and time (2026-11-02T18:00, local time if no offset). Empty clears it."
        },
        "priority": {
          "name": "Priority",
          "description": "1 = High, 2 = Medium, 3 = Low."
        },
        "assignee": {
          "name": "Assignee",
          "description": "Person responsible for the item."
        },
        "parent": {
          "name": "Parent",
          "description": "Parent (to-do list) ID, e.g. household."
        }
      }
    },
    "set_status": {
      "name": "Set status",
      "description": "Completes or reopens an item, including archived ones.",
      "fields": {
        "uid": {
          "name": "Item ID",
          "description": "The item's UID."
        },
        "status": {
          "name": "Status",
          "description": "needs_action or completed."
        }
      }
    },
    "delete_item": {
      "name": "Delete item",
      "description": "Removes an item.",
      "fields": {
        "uid": {
          "name": "Item ID",
          "description": "The item's UID."
        }
      }
    }
  },
  "exceptions": {
    "not_loaded": {
      "message": "Household Kanban is not loaded."
    },
    "unknown_item": {
      "message": "Unknown item: {value}."
    },
    "unknown_parent": {
      "message": "Unknown parent: {value}."
    },
    "unknown_person": {
      "message": "Unknown person: {value}."
    },
    "invalid_due": {
      "message": "Invalid due value: {value}. Use a date or an ISO date and time."
    }
  }
